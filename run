#!/usr/bin/env bash
set -euo pipefail
script=$(readlink -f -- "$0")
root=$(cd -- "$(dirname -- "$script")" && pwd)
database=()
arguments=()
while (($#)); do
    case $1 in
        --db)
            if (($# < 2)); then
                printf '%s\n' 'error: --db requires a value' >&2
                exit 2
            fi
            database=(--db "$2")
            shift 2
            ;;
        --db=*)
            database=("$1")
            shift
            ;;
        *)
            arguments+=("$1")
            shift
            ;;
    esac
done
exec "$root/practice" "${database[@]}" run "${arguments[@]}"
