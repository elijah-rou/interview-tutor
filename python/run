#!/usr/bin/env sh
set -u
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

exact_problem=0
if [ "$#" -eq 2 ] && [ "$1" = "--problem" ]; then
    exact_problem=1
    set -- "$2"
fi

if [ "$exact_problem" -eq 0 ] && [ "$#" -eq 1 ] && [ "$1" = "all" ]; then
    slugs=$(python3 "$ROOT/runner.py" --list) || exit $?
    if [ -z "$slugs" ]; then
        printf '%s\n' 'error: Python adapter registry is empty' >&2
        exit 2
    fi
    status=0
    for slug in $slugs; do
        "$ROOT/run" "$slug" || status=1
    done
    exit "$status"
fi

if [ "$#" -ne 1 ] || [ "$1" = "--list" ]; then
    exec python3 "$ROOT/runner.py" "$@"
fi

start_ms=$(date +%s%3N)
python3 "$ROOT/runner.py" "$@"
status=$?
end_ms=$(date +%s%3N)
if [ "${PRACTICE_NO_RECORD:-0}" != "1" ]; then
    case $status in
        0) result=pass ;;
        2) result=error ;;
        12[89]|1[3-9][0-9]|2[0-4][0-9]|25[0-5]) result=cancelled ;;
        *) result=fail ;;
    esac
    if [ -n "${PRACTICE_PROBLEM_SET:-}" ]; then
        "$ROOT/../practice" _record python "$1" "$result" "$((end_ms - start_ms))" \
            --exit-code "$status" --problem-set "$PRACTICE_PROBLEM_SET" || \
            printf '%s\n' 'warning: could not record progress' >&2
    else
        "$ROOT/../practice" _record python "$1" "$result" "$((end_ms - start_ms))" \
            --exit-code "$status" || \
            printf '%s\n' 'warning: could not record progress' >&2
    fi
fi
exit "$status"
