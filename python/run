#!/usr/bin/env sh
set -u
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# Judge protocol used by `practice run`: list cases, or run exactly one case.
if [ "$#" -eq 2 ] && [ "$1" = "--cases" ]; then
    exec python3 "$ROOT/runner.py" --cases "$2"
fi
if [ "$#" -eq 4 ] && [ "$1" = "--problem" ] && [ "$3" = "--case" ]; then
    exec python3 "$ROOT/runner.py" --case "$2" "$4"
fi

exact_problem=0
if [ "$#" -eq 2 ] && [ "$1" = "--problem" ]; then
    exact_problem=1
    set -- "$2"
fi

if [ "$exact_problem" -eq 0 ] && [ "$#" -eq 1 ] && [ "$1" = "all" ]; then
    slugs=$(python3 "$ROOT/runner.py" --list) || exit $?
    if [ -z "$slugs" ]; then
        printf '%s\n' 'error: Python adapter registry is empty' >&2
        exit 2
    fi
    status=0
    for slug in $slugs; do
        "$ROOT/run" --problem "$slug" || status=1
    done
    exit "$status"
fi

if [ "$#" -ne 1 ] || [ "$1" = "--list" ]; then
    exec python3 "$ROOT/runner.py" "$@"
fi

# One problem: run every case in-process without recording, or record through practice,
# which captures each case's output.
if [ "${PRACTICE_NO_RECORD:-0}" = "1" ]; then
    exec python3 "$ROOT/runner.py" "$1"
fi
if [ -n "${PRACTICE_PROBLEM_SET:-}" ]; then
    exec "$ROOT/../practice" run python "$PRACTICE_PROBLEM_SET" "$1"
fi
exec "$ROOT/../practice" run python "$1"
