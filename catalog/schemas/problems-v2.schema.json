{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_revision",
    "problems"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "catalog_revision": {
      "type": "integer",
      "minimum": 1
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "title",
          "difficulty",
          "topic",
          "leetcode_id",
          "premium",
          "leetcode_url",
          "neetcode_url",
          "statement_markdown",
          "test_revision",
          "adapters"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^(?=.*[a-z])[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "difficulty": {
            "enum": [
              "Easy",
              "Medium",
              "Hard"
            ]
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "leetcode_id": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "premium": {
            "type": "boolean"
          },
          "leetcode_url": {
            "type": "string"
          },
          "neetcode_url": {
            "type": "string"
          },
          "statement_markdown": {
            "type": "string"
          },
          "test_revision": {
            "type": "integer",
            "minimum": 1
          },
          "adapters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "language",
                "solution_path"
              ],
              "properties": {
                "language": {
                  "type": "string"
                },
                "solution_path": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
