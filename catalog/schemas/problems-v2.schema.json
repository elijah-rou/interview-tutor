{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "The portable URL pattern rejects ASCII controls and whitespace plus backslashes, while runtime catalog validation rejects all Unicode controls and whitespace. Runtime validation also enforces cross-record uniqueness and adapter path existence because portable JSON Schema regex and cross-record support varies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_revision",
    "problems"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "catalog_revision": {
      "type": "integer",
      "minimum": 1
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "title",
          "difficulty",
          "topic",
          "leetcode_id",
          "premium",
          "leetcode_url",
          "neetcode_url",
          "statement_markdown",
          "test_revision",
          "adapters"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^(?=.*[a-z])[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "title": {
            "type": "string",
            "pattern": "\\S",
            "maxLength": 200
          },
          "difficulty": {
            "enum": [
              "Easy",
              "Medium",
              "Hard"
            ]
          },
          "topic": {
            "type": "string",
            "pattern": "\\S",
            "maxLength": 100
          },
          "leetcode_id": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "premium": {
            "type": "boolean"
          },
          "leetcode_url": {
            "$ref": "#/$defs/httpUrl"
          },
          "neetcode_url": {
            "$ref": "#/$defs/httpUrl"
          },
          "statement_markdown": {
            "type": "string",
            "pattern": "\\S",
            "maxLength": 1000000
          },
          "test_revision": {
            "type": "integer",
            "minimum": 1
          },
          "adapters": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": [
                "language",
                "solution_path"
              ],
              "properties": {
                "language": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "solution_path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!\\./)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "httpUrl": {
      "type": "string",
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u0020\\u007F\\\\])https?://(?:\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9._-]+)(?::[0-9]+)?(?:[/?#][^\\s\\\\]*)?$"
    }
  }
}
