{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Problem-set IDs are unique across files, member slugs are unique within a set, and ordinals are contiguous in array order; runtime catalog validation enforces these cross-record constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "description",
    "members"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "name": {
      "type": "string",
      "pattern": "\\S",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "problem_slug"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "problem_slug": {
            "type": "string",
            "pattern": "^(?=.*[a-z])[a-z0-9][a-z0-9_-]{0,63}$"
          }
        }
      }
    }
  }
}
