#!/usr/bin/env bash
set -uo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
judge=(cargo run --locked --quiet --manifest-path "$root/Cargo.toml" --bin local-judge-rust --)

# Judge protocol used by `practice run`: list cases (this step builds the judge), or run
# exactly one case.
if [[ $# -eq 2 && $1 == --cases ]]; then
    exec "${judge[@]}" --cases "$2"
fi
if [[ $# -eq 4 && $1 == --problem && $3 == --case ]]; then
    exec "${judge[@]}" --case "$2" "$4"
fi

exact_problem=0
if [[ $# -eq 2 && $1 == --problem ]]; then
    exact_problem=1
    set -- "$2"
fi

if [[ $exact_problem -eq 0 && $# -eq 1 && $1 == all ]]; then
    slugs=$("${judge[@]}" --list) || exit $?
    if [[ -z $slugs ]]; then
        printf '%s\n' 'error: Rust adapter registry is empty' >&2
        exit 2
    fi
    status=0
    while read -r slug; do
        "$root/run" --problem "$slug" || status=1
    done <<< "$slugs"
    exit "$status"
fi

if [[ $# -ne 1 || $1 == --list ]]; then
    exec "${judge[@]}" "$@"
fi

# One problem: run every case in-process without recording, or record through practice,
# which captures each case's output.
if [[ ${PRACTICE_NO_RECORD:-0} == 1 ]]; then
    exec "${judge[@]}" "$1"
fi
if [[ -n ${PRACTICE_PROBLEM_SET:-} ]]; then
    exec "$root/../practice" run rust "$PRACTICE_PROBLEM_SET" "$1"
fi
exec "$root/../practice" run rust "$1"
