#!/usr/bin/env bash
set -uo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

exact_problem=0
if [[ $# -eq 2 && $1 == --problem ]]; then
    exact_problem=1
    set -- "$2"
fi

if [[ $exact_problem -eq 0 && $# -eq 1 && $1 == all ]]; then
    slugs=$(cargo run --locked --quiet --manifest-path "$root/Cargo.toml" \
        --bin local-judge-rust -- --list) || exit $?
    if [[ -z $slugs ]]; then
        printf '%s\n' 'error: Rust adapter registry is empty' >&2
        exit 2
    fi
    status=0
    while read -r slug; do
        "$root/run" "$slug" || status=1
    done <<< "$slugs"
    exit "$status"
fi

if [[ $# -ne 1 || $1 == --list ]]; then
    exec cargo run --locked --quiet --manifest-path "$root/Cargo.toml" \
        --bin local-judge-rust -- "$@"
fi

start_ms=$(date +%s%3N)
cargo run --locked --quiet --manifest-path "$root/Cargo.toml" \
    --bin local-judge-rust -- "$1"
status=$?
end_ms=$(date +%s%3N)
if [[ ${PRACTICE_NO_RECORD:-0} != 1 ]]; then
    case $status in
        0) result=pass ;;
        2) result=error ;;
        12[89]|1[3-9][0-9]|2[0-4][0-9]|25[0-5]) result=cancelled ;;
        *) result=fail ;;
    esac
    record=("$root/../practice" _record rust "$1" "$result" "$((end_ms - start_ms))"
        --exit-code "$status")
    if [[ -n ${PRACTICE_PROBLEM_SET:-} ]]; then
        record+=(--problem-set "$PRACTICE_PROBLEM_SET")
    fi
    "${record[@]}" || printf '%s\n' 'warning: could not record progress' >&2
fi
exit "$status"
