{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/problem-set.schema.json",
  "title": "Local practice problem set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "description",
    "problems"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "problems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "slug",
          "title",
          "difficulty",
          "topic",
          "leetcode_id",
          "premium",
          "source_url",
          "neetcode_url",
          "test_revision"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "difficulty": {
            "enum": [
              "Easy",
              "Medium",
              "Hard"
            ]
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "leetcode_id": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "premium": {
            "type": "boolean"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "neetcode_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://neetcode\\.io/problems/"
          },
          "test_revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
